# Copy this file to .env at the project root and adjust as needed.
# These are consumed by docker-compose.yml.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# MySQL
DB_DATABASE=transptrack
DB_USERNAME=transptrack
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootpass
DB_PORT=3307

# Ports exposed on the host
API_PORT=8080
WEB_PORT=5173

# Run `php artisan migrate --force` on first boot
RUN_MIGRATIONS=true

# Frontend (baked into the React bundle at build time)
VITE_API_URL=http://localhost:8080
VITE_REVERB_APP_KEY=transport-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
